<Window x:Class="LedgerDesk.ConfirmDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="430" Height="270" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Window.Resources><Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
 <Border CornerRadius="20" Background="White" BorderBrush="#E2E9E5" BorderThickness="1"><Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity=".22"/></Border.Effect><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="15" Background="#FFF0EE"><TextBlock Text="!" FontSize="24" FontWeight="Bold" Foreground="#C44F49" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,2"><TextBlock Text="删除这笔账目？" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="删除后将立即同步统计图表" Foreground="#7A8881" Margin="0,5,0,0"/></StackPanel></StackPanel><StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock x:Name="EntryText" TextWrapping="Wrap" Foreground="#43534B"/><TextBlock Text="此操作无法撤销，建议先确认账目内容。" Foreground="#A16A65" FontSize="11" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="保留账目" Click="Cancel_Click" Background="#EFF3F1" Foreground="#405149"/><Button Content="确认删除" Click="Confirm_Click" Background="#C5534D" Foreground="White"/></StackPanel></Grid></Border>
</Window>
