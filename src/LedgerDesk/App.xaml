<Application x:Class="LedgerDesk.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="ShellWindow.xaml"><Application.Resources>
 <SolidColorBrush x:Key="Green" Color="#176B51"/><SolidColorBrush x:Key="Bg" Color="#F4F7F5"/><SolidColorBrush x:Key="Border" Color="#DDE7E2"/><SolidColorBrush x:Key="Muted" Color="#75817B"/>
 <Style x:Key="RoundedTextBox" TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,5,0,10"/><Setter Property="Background" Value="#F8FBF9"/><Setter Property="BorderBrush" Value="#DDE7E2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#3A9272"/><Setter TargetName="B" Property="Background" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}"/>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,5,0,10"/><Setter Property="Background" Value="#F8FBF9"/><Setter Property="BorderBrush" Value="#DDE7E2"/><Setter Property="MinHeight" Value="38"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11"/><ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><Grid Margin="12,0,10,0"><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#6F7D76" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="White" BorderBrush="#DDE7E2" BorderThickness="1" CornerRadius="11" Padding="5" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity=".16"/></Border.Effect><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#3A9272"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="11,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="B" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="#E8F4EF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#DDF0E8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,5,0,11"/><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#F8FBF9"/><Setter Property="BorderBrush" Value="#DDE7E2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11"/><DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" BorderThickness="0" Padding="11,8" VerticalContentAlignment="Center"/><Button x:Name="PART_Button" Width="38" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Content="⌄" Foreground="#557067"/><Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" CornerRadius="12" BorderBrush="#DDE7E2" BorderThickness="1" Padding="7"><Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity=".18"/></Border.Effect><Calendar x:Name="PART_Calendar"/></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#3A9272"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Application.Resources></Application>
